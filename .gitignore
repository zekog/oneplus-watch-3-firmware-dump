# Exclude heavy disk and partition images
*.img
*.dat
*.dat.br
*.transfer.list
*.patch.dat
dynamic_partitions_op_list

# Exclude raw unpack dumps
vendor_dump/
system_dump/
extracted_images/vendor_dump/
extracted_images/system_dump/
extracted_images/boot_dump/
extracted_images/init_boot_dump/
extracted_images/vendor_boot_dump/
extracted_images/temp_vendor_boot/
extracted_images/*_extracted/
reports/*_decompiled/
logdump_extracted/
logfs_extracted/

# Exclude raw OTA firmware packages and heavy partition blobs
firmware/
META-INF/
firmware-update/dspso.bin
firmware-update/NON-HLOS.bin
firmware-update/static_nvbk.bin
firmware-update/dtbo.img
oneplus_watch_3_OPWWE251_firmware_dump.zip

# Exclude raw kernel binary (kernel_with_symbols.elf is kept)
extracted_images/kernel

# Python cache and temporary files
__pycache__/
*.py[cod]
*.part
*.tmp

# Archive files
*.zip
*.7z
*.tar.gz
*.tar.xz

# Ensure target artifacts are preserved
!extracted_images/device_tree/
!extracted_images/device_tree/*
!extracted_images/kernel_with_symbols.elf
!mcu_firmware/
!mcu_firmware/**
!extracted_images/vendor_dlkm_extracted/
!extracted_images/vendor_dlkm_extracted/**

# Agent execution logs
agent_log.txt
blockers.txt

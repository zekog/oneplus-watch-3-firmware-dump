/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Monaco Watch V5B01 overlay";
	qcom,board-id = <0x10022 0x01>;
	oplus,project-id = <0x6185>;
	oplus,hw-id = <0x04 0x00 0x00>;

	fragment@0 {
		target = <&thermal_zones>;

		__overlay__ {

			pm5100-tz {

				cooling-maps {

					trip0_cpu0 {
						trip = <&pm5100_trip0>;
						cooling-device = <&CPU0>, <0x01 0x01>;
					};

					trip1_cpu2 {
						trip = <&pm5100_trip0>;
						cooling-device = <&cpu2_pause>, <0x01 0x01>;
					};

					trip1_cpu3 {
						trip = <&pm5100_trip0>;
						cooling-device = <&cpu3_pause>, <0x01 0x01>;
					};
				};
			};

			pm5100-bcl-lvl0 {

				cooling-maps {

					cpu0_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&CPU0>, <0x02 0x02>;
					};

					cpu2_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&cpu2_pause>, <0x01 0x01>;
					};

					cpu3_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&cpu3_pause>, <0x01 0x01>;
					};

					gpu_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};

			pm5100-bcl-lvl1 {

				cooling-maps {

					cpu0_cdev {
						trip = <&bcl_lvl1>;
						cooling-device = <&CPU0>, <0x02 0x02>;
					};

					cpu1_cdev {
						trip = <&bcl_lvl1>;
						cooling-device = <&cpu1_pause>, <0x01 0x01>;
					};

					gpu_cdev {
						trip = <&bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x04 0xffffffff>;
					};
				};
			};

			pm5100-bcl-lvl2 {

				cooling-maps {
				};
			};

			socd {

				cooling-maps {

					soc_cpu0 {
						trip = <&socd_trip>;
						cooling-device = <&CPU0>, <0x01 0x01>;
					};

					soc_cpu2 {
						trip = <&socd_trip>;
						cooling-device = <&cpu2_pause>, <0x01 0x01>;
					};

					soc_cpu3 {
						trip = <&socd_trip>;
						cooling-device = <&cpu3_pause>, <0x01 0x01>;
					};

					gpu_cdev {
						trip = <&socd_trip>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&pm5100_haptics>;

		__overlay__ {

			effect_6 {
				qcom,effect-id = <0x11>;
				qcom,wf-vmax-mv = <0x12c0>;
				qcom,wf-fifo-data = <0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff 0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff>;
				qcom,wf-fifo-period = <0x06>;
				qcom,wf-brake-disable;
				qcom,wf-auto-res-disable;
			};


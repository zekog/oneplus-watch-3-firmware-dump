	fragment@29 {
		target = <&soc>;

		__overlay__ {
			qcom,battery-data = <&monaco_batterydata>;
			qcom,hold-soc-while-full;
		};
	};

	fragment@30 {
		target = <&pm5100_qbg>;

		__overlay__ {
			qcom,vbat-cutoff-mv = <0xce4>;
			qcom,iterm-ma = <0x19>;
		};
	};

	fragment@31 {
		target = <&bcmdhd_wlan_0>;

		__overlay__ {
			nvram = "nvram_22907.txt";
		};
	};

	fragment@32 {
		target = <&qupv3_se4_4uart>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@33 {
		target = <&qupv3_se5_4uart>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@34 {
		target = <&qupv3_se3_spi>;

		__overlay__ {
			status = "okay";
			qcom,rt;
			qcom,slv-ctrl;
			qcom,use-fixed-timeout;

			occ0: slave@0 {
				compatible = "oplus,dual_comm_slave";
				reg = <0x00>;
				spi-max-frequency = <0x2dc6c00>;
				spi_bits_per_word = <0x20>;
				label = "ocm";
				m2s_int_gpio = <&tlmm>, <0x20 0x00>;
				s2m_ans_gpio = <&tlmm>, <0x18 0x00>;
				s2m_int_gpio = <&tlmm>, <0x19 0x00>;
				m2s_ans_gpio = <&tlmm>, <0x55 0x00>;
				phandle = <0x7c>;
			};
		};
	};

	fragment@35 {
		target = <&qupv3_se7_spi_a>;

		__overlay__ {
			status = "ok";
			qcom,rt;
			qcom,use-fixed-timeout;

			occ1: slave@0 {
				status = "ok";
				compatible = "chip_comm_plus";
				reg = <0x00>;
				spi-max-frequency = <0x16e3600>;
				spi_bits_per_word = <0x20>;
				label = "ocmp";
				m2s_int_gpio = <&tlmm>, <0x30 0x00>;
				s2m_ans_gpio = <&tlmm>, <0x07 0x00>;
				s2m_int_gpio = <&tlmm>, <0x08 0x00>;
				m2s_ans_gpio = <&tlmm>, <0x31 0x00>;
				phandle = <0x7d>;
			};
		};
	};

	fragment@36 {
		target = <&osh>;

		__overlay__ {
			reset-gpio = <&tlmm>, <0x40 0x00>;
			power-gpio = <&tlmm>, <0x70 0x01>;
			buck-enable-gpio = <&tlmm>, <0x21 0x00>;
			dead-gpio = <&tlmm>, <0x6d 0x01>;
			pinctrl-names = "default";
			pinctrl-0 = <&sensor_hub_reset_default>, <&sensor_hub_buck_enable_default>;
		};
	};

	fragment@37 {
		target = <&tlmm>;

		__overlay__ {

			sensor_hub_reset_default: sensor_hub_reset_default {
				phandle = <0x54>;

				mux {
					pins = "gpio64";
					function = "gpio";
				};

				config {
					pins = "gpio64";
					input-enable;
					bias-pull-down;
					drive-strength = <0x02>;
				};
			};

			sensor_hub_buck_enable_default: sensor_hub_buck_enable_default {
				phandle = <0x55>;

				mux {
					pins = "gpio33";
					function = "gpio";
				};

				config {
					pins = "gpio33";
					output-low;
					bias-pull-down;
					drive-strength = <0x08>;
				};
			};
		};
	};

	fragment@38 {
		target = <&soc>;

		__overlay__ {

			tp_vdd_1v8: gpio-regulator@61 {
				compatible = "regulator-fixed";
				regulator-name = "tp_vdd_1v8";
				gpio = <&tlmm>, <0x3d 0x00>;
				enable-active-high;
				phandle = <0x52>;
			};

			tp_vdd_3v0: gpio-regulator@107 {
				compatible = "regulator-fixed";
				regulator-name = "tp_vdd_3v0";
				gpio = <&tlmm>, <0x6b 0x00>;
				enable-active-high;
				phandle = <0x53>;
			};
		};
	};

	fragment@39 {
		target = <&qupv3_se4_4uart>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@40 {
		target = <&bluesleep>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@41 {
		target = <&usb2_phy0>;

		__overlay__ {
			qcom,param-override-seq = <0x63 0x6c 0xcf 0x70 0x12 0x74>;
		};
	};


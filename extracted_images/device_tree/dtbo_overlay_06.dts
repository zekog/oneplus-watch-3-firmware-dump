					qcom,mdss-dsi-t-clk-post = <0x09>;
					qcom,mdss-dsi-t-clk-pre = <0x0d>;
					qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
					qcom,mdss-dsi-bl-min-level = <0x01>;
					qcom,mdss-dsi-bl-max-level = <0xff>;
					qcom,ulps-enabled;
					qcom,suspend-ulps-enabled;
					qcom,dsi-select-clocks = "pll_byte_clk0", "pll_dsi_clk0";
					qcom,mdss-dsi-panel-status-check-mode = "reg_read";
					qcom,mdss-dsi-panel-status-command = <0x6010001 0x10a>;
					qcom,mdss-dsi-panel-status-command-state = "dsi_lp_mode";
					qcom,mdss-dsi-panel-status-value = <0x9c 0xdc>;
					qcom,mdss-dsi-panel-status-read-length = <0x01>;
					qcom,esd-check-enabled;
					qcom,panel-supply-entries = <&dsi_panel_pwr_supply_nolab_amoled>;
					qcom,platform-reset-gpio = <&pm5100_gpios>, <0x02 0x00>;
					qcom,platform-en-gpio = <&pm5100_gpios>, <0x01 0x00>;
					phandle = <0x5c>;

					qcom,mdss-dsi-display-timings {

						timing@0 {
							qcom,mdss-dsi-panel-framerate = <0x3c>;
							qcom,mdss-dsi-panel-width = <0x1d2>;
							qcom,mdss-dsi-panel-height = <0x1d2>;
							qcom,mdss-dsi-h-front-porch = <0x07>;
							qcom,mdss-dsi-h-back-porch = <0x07>;
							qcom,mdss-dsi-h-pulse-width = <0x02>;
							qcom,mdss-dsi-h-sync-skew = <0x00>;
							qcom,mdss-dsi-v-back-porch = <0x07>;
							qcom,mdss-dsi-v-front-porch = <0x07>;
							qcom,mdss-dsi-v-pulse-width = <0x02>;
							qcom,mdss-dsi-h-left-border = <0x00>;
							qcom,mdss-dsi-h-right-border = <0x00>;
							qcom,mdss-dsi-v-top-border = <0x00>;
							qcom,mdss-dsi-v-bottom-border = <0x00>;
							qcom,mdss-dsi-panel-clockrate = <0x19de5080>;
							qcom,mdss-dsi-on-command = [15 01 00 00 00 00 02 fe 20 15 01 00 00 00 00 02 f4 5a 15 01 00 00 00 00 02 f5 59 15 01 00 00 00 00 02 fe d0 15 01 00 00 00 00 02 33 30 15 01 00 00 00 00 02 35 30 15 01 00 00 00 00 02 36 30 15 01 00 00 00 00 02 37 30 15 01 00 00 00 00 02 fe 80 15 01 00 00 00 00 02 66 11 15 01 00 00 00 00 02 67 10 15 01 00 00 00 00 02 68 04 15 01 00 00 00 00 02 90 0c 15 01 00 00 00 00 02 93 44 15 01 00 00 00 00 02 c3 e7 15 01 00 00 00 00 02 fe d0 15 01 00 00 00 00 02 21 23 15 01 00 00 00 00 02 3a 07 15 01 00 00 00 00 02 3b 14 15 01 00 00 00 00 02 1c 10 15 01 00 00 00 00 02 fe 90 15 01 00 00 00 00 02 4d 0b 15 01 00 00 00 00 02 fe 40 15 01 00 00 00 00 02 0b 0a 15 01 00 00 00 00 02 fe 40 15 01 00 00 00 00 02 12 ff 15 01 00 00 00 00 02 13 e8 15 01 00 00 00 00 02 c9 41 15 01 00 00 00 00 02 96 79 15 01 00 00 00 00 02 97 02 15 01 00 00 00 00 02 a5 ff 15 01 00 00 00 00 02 aa 12 15 01 00 00 00 00 02 ab 3f 15 01 00 00 00 00 02 98 00 15 01 00 00 00 00 02 a7 0f 15 01 00 00 00 00 02 a9 43 15 01 00 00 00 00 02 fe 20 15 01 00 00 00 00 02 f4 a5 15 01 00 00 00 00 02 f5 a5 15 01 00 00 00 00 02 fe 00 15 01 00 00 00 00 02 35 00 15 01 00 00 00 00 02 53 20 15 01 00 00 00 00 02 63 ff 39 01 00 00 00 00 05 2a 00 08 01 d9 39 01 00 00 00 00 05 2b 00 00 01 d1 05 01 00 00 3c 00 01 11 05 01 00 00 00 00 01 29];
							qcom,mdss-dsi-off-command = [15 01 00 00 00 00 02 fe 00 05 01 00 00 00 00 01 28 05 01 00 00 64 00 01 10];
							qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
							qcom,mdss-dsi-lp1-command = [15 01 00 00 00 00 02 fe 00 15 01 00 00 00 00 02 39 00];
							qcom,mdss-dsi-nolp-command = [15 01 00 00 00 00 02 fe 00 15 01 00 00 00 00 02 38 00];
							qcom,mdss-dsi-lp1-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-nolp-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-hbm-on-command = <0x15010000 0x2fe 0x20150100 0x02 0xf45a1501 0x00 0x2f55915 0x1000000 0x2fe70 0x15010000 0x265 0xe0150100 0x02 0x66061501 0x00 0x2671015 0x1000000 0x2fe20 0x15010000 0x2f4 0xa5150100 0x02 0xf5a51501 0x00 0x2fe0015 0x1000000 0x26602>;
							qcom,mdss-dsi-hbm-off-command = [15 01 00 00 00 00 02 fe 00 15 01 00 00 00 00 02 66 00 15 01 00 00 00 00 02 fe 20 15 01 00 00 00 00 02 f4 5a 15 01 00 00 00 00 02 f5 59 15 01 00 00 00 00 02 fe 70 15 01 00 00 00 00 02 65 f0 15 01 00 00 00 00 02 66 48 15 01 00 00 00 00 02 67 00 15 01 00 00 00 00 02 fe 20 15 01 00 00 00 00 02 f4 a5 15 01 00 00 00 00 02 f5 a5 15 01 00 00 00 00 02 fe 00];
							qcom,mdss-dsi-hbm-on-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-hbm-off-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-data-dimming-on-command = [15 01 00 00 00 00 02 fe 00 15 01 00 00 00 00 02 53 28];
							qcom,mdss-dsi-data-dimming-off-command = [15 01 00 00 00 00 02 fe 00 15 01 00 00 00 00 02 53 20];
							qcom,mdss-dsi-data-dimming-on-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-data-dimming-off-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-lock-command = <0x15010000 0x2fe 0x80150100 0x02 0xf4ac1501 0x00 0x2f5e115 0x1000000 0x2fe00>;
							qcom,mdss-dsi-unlock-command = <0x15010000 0x2fe 0x80150100 0x02 0xf4001501 0x00 0x2f50015 0x1000000 0x2fe00>;
							qcom,mdss-dsi-lock-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-unlock-command-state = "dsi_lp_mode";
							qcom,mdss-dsi-panel-phy-timings = [00 0e 03 03 11 1d 04 04 03 02 04 00 0d 09];
							qcom,display-topology = <0x01 0x00 0x01>;
							qcom,default-topology-index = <0x00>;
						};
					};
				};
			};

			mdss_dsi0: qcom,mdss_dsi0_ctrl@5e94000 {
				compatible = "qcom,dsi-ctrl-hw-v2.4";
				label = "dsi-ctrl-0";
				cell-index = <0x00>;
				reg = <0x5e94000 0x400 0x5f08000 0x04>;
				reg-names = "dsi_ctrl", "disp_cc_base";
				interrupt-parent = <&mdss_mdp>;
				interrupts = <0x04 0x00>;
				vdda-1p2-supply = <&L9A>;
				clocks = <&dispcc>, <0x02>, <&dispcc>, <0x03>, <&dispcc>, <0x05>, <&dispcc>, <0x0c>, <&dispcc>, <0x0d>, <&dispcc>, <0x06>, <&rpmcc>, <0x00>;
				clock-names = "byte_clk", "byte_clk_rcg", "byte_intf_clk", "pixel_clk", "pixel_clk_rcg", "esc_clk", "xo";
				phandle = <0x08>;

				qcom,ctrl-supply-entries {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					qcom,ctrl-supply-entry@0 {
						reg = <0x00>;
						qcom,supply-name = "vdda-1p2";
						qcom,supply-min-voltage = <0x12cc80>;
						qcom,supply-max-voltage = <0x140500>;
						qcom,supply-enable-load = <0x5528>;
						qcom,supply-disable-load = <0x00>;
						qcom,supply-ulp-load = <0x00>;
					};
				};

				qcom,core-supply-entries {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					qcom,core-supply-entry@0 {
						reg = <0x00>;
						qcom,supply-name = "refgen";
						qcom,supply-min-voltage = <0x00>;
						qcom,supply-max-voltage = <0x00>;
						qcom,supply-enable-load = <0x00>;
						qcom,supply-disable-load = <0x00>;
					};
				};
			};

			mdss_dsi_phy0: qcom,mdss_dsi_phy0@5e94400 {
				compatible = "qcom,dsi-phy-v4.2";
				label = "dsi-phy-0";
				cell-index = <0x00>;
				#clock-cells = <0x01>;
				reg = <0x5e94400 0x800 0x5e94900 0x27c 0x5e94200 0x100 0x5f03000 0x08>;
				reg-names = "dsi_phy", "pll_base", "dyn_refresh_base", "gdsc_base";
				pll-label = "dsi_pll_5nm";
				vdda-0p9-supply = <&L12A>;
				qcom,platform-strength-ctrl = [ff 06 ff 06 ff 06 ff 06 ff 00];
				qcom,platform-lane-config = <0xa0a 0xa0a 0xa0a 0xa0a 0x8a8a>;
				qcom,platform-regulator-settings = [1d 1d 1d 1d 1d];
				qcom,dsi-pll-ssc-en;
				qcom,dsi-pll-ssc-mode = "down-spread";
				qcom,panel-allow-phy-poweroff;
				qcom,phy-clamp-enable;
				pll_codes_region = <&dsi_pll_codes_data>;
				memory-region = <&dfps_data_memory>;
				phandle = <0x09>;

				qcom,phy-supply-entries {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					qcom,phy-supply-entry@0 {
						reg = <0x00>;
						qcom,supply-name = "vdda-0p9";
						qcom,supply-min-voltage = <0xdcb40>;
						qcom,supply-max-voltage = <0xdcb40>;
						qcom,supply-enable-load = <0x92ae>;
						qcom,supply-disable-load = <0x00>;
						qcom,supply-ulp-load = <0x00>;
					};
				};
			};

			dsi_pll_codes_data: dsi_pll_codes {
				reg = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
				label = "dsi_pll_codes";
				phandle = <0x07>;
			};
		};
	};

	fragment@8 {
		target = <&soc>;

		__overlay__ {

			dsi_panel_pwr_supply: dsi_panel_pwr_supply {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x5d>;

				qcom,panel-supply-entry@0 {
					reg = <0x00>;
					qcom,supply-name = "vddio";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1e8480>;
					qcom,supply-enable-load = <0xfa0>;
					qcom,supply-ulp-load = <0x64>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-post-on-sleep = <0x14>;
				};

				qcom,panel-supply-entry@1 {
					reg = <0x01>;
					qcom,supply-name = "lab";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
				};

				qcom,panel-supply-entry@2 {
					reg = <0x02>;
					qcom,supply-name = "ibb";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-post-on-sleep = <0x14>;
				};
			};

			dsi_panel_pwr_supply_no_labibb: dsi_panel_pwr_supply_no_labibb {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x5e>;

				qcom,panel-supply-entry@0 {
					reg = <0x00>;
					qcom,supply-name = "vddio";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1e8480>;
					qcom,supply-enable-load = <0xfa0>;
					qcom,supply-ulp-load = <0x64>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-post-on-sleep = <0x14>;
				};
			};

			dsi_panel_pwr_supply_labibb_amoled: dsi_panel_pwr_supply_labibb_amoled {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x5f>;

				qcom,panel-supply-entry@0 {
					reg = <0x00>;
					qcom,supply-name = "vddio";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1e8480>;
					qcom,supply-enable-load = <0xfa0>;
					qcom,supply-ulp-load = <0x64>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-post-on-sleep = <0x14>;
				};

				qcom,panel-supply-entry@1 {
					reg = <0x01>;
					qcom,supply-name = "vdda-3p3";
					qcom,supply-min-voltage = <0x2dc6c0>;
					qcom,supply-max-voltage = <0x2dc6c0>;
					qcom,supply-enable-load = <0x3390>;
					qcom,supply-disable-load = <0x50>;
				};
			};

			dsi_panel_pwr_supply_nolab_amoled: dsi_panel_pwr_supply_nolab_amoled {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x05>;

				qcom,panel-supply-entry@0 {
					reg = <0x00>;
					qcom,supply-name = "vddio";
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-max-voltage = <0x1e8480>;
					qcom,supply-enable-load = <0xfa0>;
					qcom,supply-ulp-load = <0x64>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-post-on-sleep = <0x00>;
				};

				qcom,panel-supply-entry@1 {
					reg = <0x01>;
					qcom,supply-name = "ibb";
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-enable-load = <0x00>;
					qcom,supply-disable-load = <0x00>;
				};
			};

			display_panel_ibb: display_panel_ibb_stub {
				compatible = "qcom,stub-regulator";
				regulator-name = "display_panel_ibb";
				regulator-min-microvolt = <0x4630c0>;
				regulator-max-microvolt = <0x5b8d80>;
				phandle = <0x0b>;
			};

			vddio_oled: gpio-regulator@39 {
				compatible = "regulator-fixed";
				regulator-name = "vddio_oled";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				gpio = <&tlmm>, <0x27 0x00>;
				enable-active-high;
				regulator-boot-on;
				phandle = <0x0a>;
			};

			sde_dsi: qcom,dsi-display-primary {
				compatible = "qcom,dsi-display";
				label = "primary";
				qcom,dsi-ctrl = <&mdss_dsi0>;
				qcom,dsi-phy = <&mdss_dsi_phy0>;
				clocks = <&mdss_dsi_phy0>, <0x00>, <&mdss_dsi_phy0>, <0x01>, <&dispcc>, <0x08>;
				clock-names = "pll_byte_clk0", "pll_dsi_clk0", "mdp_core_clk";
				pinctrl-names = "panel_active", "panel_suspend";
				pinctrl-0 = <&sde_te_active>;
				pinctrl-1 = <&sde_te_suspend>;
				qcom,platform-te-gpio = <&tlmm>, <0x49 0x00>;
				qcom,panel-te-source = <0x00>;
				qcom,needs-clk-src-reset;
				qcom,needs-ctrl-vreg-disable;
				vddio-supply = <&vddio_oled>;
				ibb-supply = <&display_panel_ibb>;
				qcom,mdp = <&mdss_mdp>;
				qcom,dsi-default-panel = <&dsi_rm69090_amoled_cmd>;
				phandle = <0x03>;
			};
		};
	};

	fragment@9 {
		target = <&qupv3_se1_i2c>;

		__overlay__ {

			tsc@24 {

				parade,core {
					panel = <&dsi_rm69090_amoled_cmd>;
				};
			};
		};
	};

	fragment@10 {
		target = <&soc>;

		__overlay__ {

			stub_codec: qcom,msm-stub-codec {
				compatible = "qcom,msm-stub-codec";
				phandle = <0x19>;
			};

			audio_pkt_core_platform: qcom,audio-pkt-core-platform {
				compatible = "qcom,audio-pkt-core-platform";
				phandle = <0x60>;
			};

			adsp_loader: qcom,msm-adsp-loader {
				status = "ok";
				compatible = "qcom,adsp-loader";
				qcom,rproc-handle = <&adsp_pas>;
				qcom,adsp-state = <0x00>;
				phandle = <0x61>;
			};

			adsp_notify: qcom,msm-adsp-notify {
				status = "ok";
				compatible = "qcom,adsp-notify";
				qcom,rproc-handle = <&adsp_pas>;
				phandle = <0x62>;
			};
		};
	};

	fragment@11 {
		target = <&soc>;

		__overlay__ {

			lpass_audio_hw_vote: vote_lpass_audio_hw {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x0b>;
				#clock-cells = <0x01>;
				phandle = <0x0d>;
			};

			spf_core_platform: spf_core_platform {
				compatible = "qcom,spf-core-platform";
				phandle = <0x63>;

				msm_audio_ion: qcom,msm-audio-ion {
					compatible = "qcom,msm-audio-ion";
					qcom,smmu-version = <0x02>;
					qcom,smmu-enabled;
					iommus = <&apps_smmu>, <0x1c1 0x00>;
					qcom,smmu-sid-mask = <0x00 0x0f>;
					qcom,iommu-dma-addr-pool = <0x10000000 0x10000000>;
					phandle = <0x64>;
				};

				bolero: bolero-cdc {
					compatible = "qcom,bolero-codec";
					clock-names = "lpass_audio_hw_vote";
					clocks = <&lpass_audio_hw_vote>, <0x00>;
					qcom,num-macros = <0x03>;
					qcom,bolero-version = <0x06>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x1a>;

					bolero-clk-rsc-mngr {
						compatible = "qcom,bolero-clk-rsc-mngr";
						qcom,fs-gen-sequence = <0x3000 0x01 0x01 0x3004 0x03 0x03 0x3004 0x03 0x01 0x3080 0x02 0x02>;
						qcom,rx_mclk_mode_muxsel = <0xa5640d8>;
						qcom,va_mclk_mode_muxsel = "\nz", "";
						clock-names = "tx_core_clk", "tx_npl_clk", "rx_core_clk", "rx_npl_clk", "va_core_clk", "va_npl_clk";
						clocks = <&clock_audio_tx_1>, <0x00>, <&clock_audio_tx_2>, <0x00>, <&clock_audio_rx_1>, <0x00>, <&clock_audio_rx_2>, <0x00>, <&clock_audio_va_1>, <0x00>, <&clock_audio_va_2>, <0x00>;
					};

					va_macro: va-macro@0a730000 {
						compatible = "qcom,va-macro";
						reg = <0xa730000 0x00>;
						clock-names = "lpass_audio_hw_vote";
						clocks = <&lpass_audio_hw_vote>, <0x00>;
						qcom,va-dmic-sample-rate = <0x927c0>;
						qcom,va-clk-mux-select = <0x01>;
						qcom,va-island-mode-muxsel = "\nz", "";
						qcom,default-clk-id = <0x00>;
						qcom,is-used-swr-gpio = <0x01>;
						qcom,va-swr-gpios = <&va_swr_gpios>;
						phandle = <0x65>;

						swr0: va_swr_master {
							compatible = "qcom,swr-mstr";
							status = "disabled";
							#address-cells = <0x02>;
							#size-cells = <0x00>;
							clock-names = "lpass_audio_hw_vote";
							clocks = <&lpass_audio_hw_vote>, <0x00>;
							qcom,swr_master_id = <0x03>;
							qcom,swrm-hctl-reg = <0xa7ec100>;
							qcom,mipi-sdw-block-packing-mode = <0x01>;
							swrm-io-base = <0xa740000 0x00>;
							interrupts = <0x00 0x128 0x04 0x00 0x4f 0x04>;
							interrupt-names = "swr_master_irq", "swr_wake_irq";

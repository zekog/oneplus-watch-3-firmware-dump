								pins = "gpio15";
								function = "func1";
							};

							config {
								pins = "gpio15";
								drive-strength = <0x02>;
								bias-pull-down;
								input-enable;
							};
						};

						lpi_i2s3_ws_active: lpi_i2s3_ws_active {
							phandle = <0x3b>;

							mux {
								pins = "gpio15";
								function = "func1";
							};

							config {
								pins = "gpio15";
								drive-strength = <0x02>;
								bias-disable;
								input-enable;
							};
						};
					};

					lpi_i2s3_sd0 {

						lpi_i2s3_sd0_sleep: lpi_i2s3_sd0_sleep {
							phandle = <0x40>;

							mux {
								pins = "gpio16";
								function = "func1";
							};

							config {
								pins = "gpio16";
								drive-strength = <0x02>;
								bias-pull-down;
								input-enable;
							};
						};

						lpi_i2s3_sd0_active: lpi_i2s3_sd0_active {
							phandle = <0x3c>;

							mux {
								pins = "gpio16";
								function = "func1";
							};

							config {
								pins = "gpio16";
								drive-strength = <0x02>;
								bias-disable;
								input-enable;
							};
						};
					};

					lpi_i2s3_sd1 {

						lpi_i2s3_sd1_sleep: lpi_i2s3_sd1_sleep {
							phandle = <0x41>;

							mux {
								pins = "gpio17";
								function = "func1";
							};

							config {
								pins = "gpio17";
								drive-strength = <0x02>;
								bias-pull-down;
								input-enable;
							};
						};

						lpi_i2s3_sd1_active: lpi_i2s3_sd1_active {
							phandle = <0x3d>;

							mux {
								pins = "gpio17";
								function = "func1";
							};

							config {
								pins = "gpio17";
								drive-strength = <0x02>;
								bias-disable;
								input-enable;
							};
						};
					};
				};

				monaco_snd: sound {
					compatible = "qcom,monaco-asoc-snd";
					qcom,mi2s-audio-intf = <0x01>;
					qcom,cc-va-intf-enable = <0x00>;
					qcom,auxpcm-audio-intf = <0x00>;
					qcom,tdm-audio-intf = <0x00>;
					qcom,wcn-btfm = <0x00>;
					qcom,afe-rxtx-lb = <0x00>;
					qcom,model = "monaco-idp-snd-card";
					qcom,msm-mi2s-master = <0x01 0x01 0x01 0x01>;
					qcom,bt-slim-clk-src-ctrl = <0x01>;
					qcom,va-bolero-codec = <0x01>;
					qcom,audio-routing = "TX DMIC0", "Digital Mic0", "Digital Mic0", "MIC BIAS1", "TX DMIC1", "Digital Mic1", "Digital Mic1", "MIC BIAS1", "TX DMIC2", "Digital Mic2", "Digital Mic2", "MIC BIAS2", "TX DMIC3", "Digital Mic3", "Digital Mic3", "MIC BIAS2", "SPKR_IN", "AUX_OUT", "TX SWR_INPUT", "VA_TX_SWR_CLK", "RX_TX DEC0_INP", "TX DEC0 MUX", "RX_TX DEC1_INP", "TX DEC1 MUX", "RX_TX DEC2_INP", "TX DEC2 MUX", "RX_TX DEC3_INP", "TX DEC3 MUX", "TX_AIF1 CAP", "VA_TX_SWR_CLK", "TX_AIF2 CAP", "VA_TX_SWR_CLK", "TX_AIF3 CAP", "VA_TX_SWR_CLK", "VA SWR_INPUT", "VA_SWR_CLK", "VA_AIF1 CAP", "VA_SWR_CLK", "VA_AIF2 CAP", "VA_SWR_CLK", "VA_AIF3 CAP", "VA_SWR_CLK", "VA DMIC0", "Digital Mic0", "VA DMIC1", "Digital Mic1", "VA DMIC2", "Digital Mic2", "VA DMIC3", "Digital Mic3", "VA DMIC0", "VA MIC BIAS1", "VA DMIC1", "VA MIC BIAS1", "VA DMIC2", "VA MIC BIAS2", "VA DMIC3", "VA MIC BIAS2", "AMIC1", "Analog Mic1", "Analog Mic1", "MIC BIAS1", "AMIC2", "Analog Mic2", "Analog Mic2", "MIC BIAS2", "SPKR_IN", "AUX_OUT", "TX SWR_INPUT", "VA_TX_SWR_CLK", "RX_SWR_TX_PCM_IN0", "RX_MCLK", "RX_SWR_TX_PCM_IN1", "RX_MCLK", "RX_SWR_TX_PCM_IN0", "ADC1_OUTPUT", "RX_SWR_TX_PCM_IN1", "ADC2_OUTPUT", "RX_TX DEC0_INP", "TX DEC0 MUX", "RX_TX DEC1_INP", "TX DEC1 MUX", "RX_TX DEC2_INP", "TX DEC2 MUX", "RX_TX DEC3_INP", "TX DEC3 MUX", "TX_AIF1 CAP", "VA_TX_SWR_CLK", "TX_AIF2 CAP", "VA_TX_SWR_CLK", "TX_AIF3 CAP", "VA_TX_SWR_CLK", "VA SWR_INPUT", "VA_SWR_CLK", "VA_AIF1 CAP", "VA_SWR_CLK", "VA_AIF2 CAP", "VA_SWR_CLK", "VA_AIF3 CAP", "VA_SWR_CLK";
					qcom,cdc-dmic01-gpios = <&cdc_dmic01_gpios>;
					qcom,cdc-dmic23-gpios = <&cdc_dmic23_gpios>;
					nvmem-cells = <&adsp_variant>;
					nvmem-cell-names = "adsp_variant";
					asoc-codec = <&stub_codec>, <&bolero>, <&besbev_codec>;
					asoc-codec-names = "msm-stub-codec.1", "bolero_codec", "besbev_codec";
					qcom,msm_audio_ssr_devs = <&audio_gpr>, <&lpi_tlmm>, <&bolero>;
					qcom,sec-mi2s-gpios = <&cdc_lpi_i2s2_gpios>;
					qcom,pri-mi2s-gpios = <&cc_pri_mi2s_gpios>;
					phandle = <0x73>;
				};

				cdc_dmic01_gpios: cdc_dmic01_pinctrl {
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&cdc_dmic01_clk_active>, <&cdc_dmic01_data_active>;
					pinctrl-1 = <&cdc_dmic01_clk_sleep>, <&cdc_dmic01_data_sleep>;
					qcom,lpi-gpios;
					#gpio-cells = <0x00>;
					phandle = <0x17>;
				};

				cdc_dmic23_gpios: cdc_dmic23_pinctrl {
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&cdc_dmic23_clk_active>, <&cdc_dmic23_data_active>;
					pinctrl-1 = <&cdc_dmic23_clk_sleep>, <&cdc_dmic23_data_sleep>;
					qcom,lpi-gpios;
					#gpio-cells = <0x00>;
					phandle = <0x18>;
				};

				rx_swr_gpios: rx_swr_clk_data_pinctrl {
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&rx_swr_clk_active>, <&rx_swr_data_active>;
					pinctrl-1 = <&rx_swr_clk_sleep>, <&rx_swr_data_sleep>;
					qcom,lpi-gpios;
					#gpio-cells = <0x00>;
					phandle = <0x15>;
				};

				va_swr_gpios: va_swr_clk_data_pinctrl {
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&tx_swr_clk_active>, <&tx_swr_data1_active>, <&tx_swr_data2_active>;
					pinctrl-1 = <&tx_swr_clk_sleep>, <&tx_swr_data1_sleep>, <&tx_swr_data2_sleep>;
					qcom,lpi-gpios;
					qcom,chip-wakeup-reg = <0x3ca064>;
					qcom,chip-wakeup-maskbit = <0x00>;
					qcom,chip-wakeup-default-val = <0x01>;
					#gpio-cells = <0x00>;
					phandle = <0x14>;
				};

				cdc_lpi_i2s2_gpios: lpi_i2s2_pinctrl {
					status = "ok";
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&lpi_i2s2_sck_active>, <&lpi_i2s2_ws_active>, <&lpi_i2s2_sd0_active>, <&lpi_i2s2_sd1_active>;
					pinctrl-1 = <&lpi_i2s2_sck_sleep>, <&lpi_i2s2_ws_sleep>, <&lpi_i2s2_sd0_sleep>, <&lpi_i2s2_sd1_sleep>;
					#gpio-cells = <0x00>;
					qcom,lpi-gpios;
					phandle = <0x1e>;
				};

				cdc_lpi_i2s3_gpios: lpi_i2s3_pinctrl {
					status = "ok";
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&lpi_i2s3_sck_active>, <&lpi_i2s3_ws_active>, <&lpi_i2s3_sd0_active>, <&lpi_i2s3_sd1_active>;
					pinctrl-1 = <&lpi_i2s3_sck_sleep>, <&lpi_i2s3_ws_sleep>, <&lpi_i2s3_sd0_sleep>, <&lpi_i2s3_sd1_sleep>;
					#gpio-cells = <0x00>;
					qcom,lpi-gpios;
					phandle = <0x74>;
				};

				cc_pri_mi2s_gpios: cc_pinctrl_pri {
					compatible = "qcom,msm-cdc-pinctrl";
					pinctrl-names = "aud_active", "aud_sleep";
					pinctrl-0 = <&lpi_i2s1_sck_active>, <&lpi_i2s1_ws_active>, <&lpi_i2s1_sd0_active>, <&lpi_i2s1_sd1_active>;
					pinctrl-1 = <&lpi_i2s1_sck_sleep>, <&lpi_i2s1_ws_sleep>, <&lpi_i2s1_sd0_sleep>, <&lpi_i2s1_sd1_sleep>;
					qcom,lpi-gpios;
					#gpio-cells = <0x00>;
					phandle = <0x1f>;
				};
			};
		};
	};

	fragment@12 {
		target = <&glink_edge>;

		__overlay__ {

			audio_gpr: qcom,gpr {
				compatible = "qcom,gpr";
				qcom,glink-channels = "adsp_apps";
				qcom,intents = <0x200 0x14>;
				reg = <0x02>;
				phandle = <0x1c>;

				spf_core {
					compatible = "qcom,spf_core";
					reg = <0x03>;
				};

				audio-pkt {
					compatible = "qcom,audio-pkt";
					qcom,audiopkt-ch-name = "apr_audio_svc";
					reg = <0x17>;
				};

				audio_prm: q6prm {
					compatible = "qcom,audio_prm";
					reg = <0x07>;
					phandle = <0x75>;
				};
			};
		};
	};

	fragment@13 {
		target = <&soc>;

		__overlay__ {

			clock_audio_rx_1: rx_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x05>;
				qcom,codec-lpass-ext-clk-freq = <0x1588800>;
				qcom,codec-lpass-clk-id = <0x30e>;
				#clock-cells = <0x01>;
				phandle = <0x10>;
			};

			clock_audio_rx_2: rx_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x06>;
				qcom,codec-lpass-ext-clk-freq = <0x1588800>;
				qcom,codec-lpass-clk-id = <0x30f>;
				#clock-cells = <0x01>;
				phandle = <0x11>;
			};

			clock_audio_tx_1: tx_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x07>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30c>;
				#clock-cells = <0x01>;
				phandle = <0x0e>;
			};

			clock_audio_tx_2: tx_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x08>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30d>;
				#clock-cells = <0x01>;
				phandle = <0x0f>;
			};

			clock_audio_va_1: va_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x02>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x307>;
				#clock-cells = <0x01>;
				phandle = <0x12>;
			};

			clock_audio_va_2: va_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x0a>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x308>;
				#clock-cells = <0x01>;
				phandle = <0x13>;
			};
		};
	};

	fragment@14 {
		target = <&oplus_switch>;

		__overlay__ {
			gpios = <&tlmm>, <0x2a 0x00>;
		};
	};

	fragment@15 {
		target = <&osh>;

		__overlay__ {
			status = "okay";
			compatible = "oplus,sensor-hub";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			ap-state-gpio = <&tlmm>, <0x50 0x00>;
			dead-gpio = <&tlmm>, <0x6d 0x01>;

			oplus,swd {
				compatible = "oplus,swd";
				reg = <0x01>;
				pinctrl-names = "default", "active", "dap_active";
				pinctrl-0 = <&swd_clk_default>, <&swd_data_default>;
				pinctrl-1 = <&swd_bus_active>;
				pinctrl-2 = <&swd_dap_active>;
				swd_clk-gpio = <&tlmm>, <0x1c 0x00>;
				swd_data-gpio = <&tlmm>, <0x1d 0x00>;
			};
		};
	};

	fragment@16 {
		target = <&tlmm>;

		__overlay__ {

			swd_bus_default {

				swd_clk_default: swd_clk_default {
					phandle = <0x4a>;

					mux {
						pins = "gpio28";
						function = "gpio";
					};

					config {
						pins = "gpio28";
						input-enable;
						bias-disable;
					};
				};

				swd_data_default: swd_data_default {
					phandle = <0x4b>;

					mux {
						pins = "gpio29";
						function = "gpio";
					};

					config {
						pins = "gpio29";
						input-enable;
						bias-disable;
					};
				};
			};

			swd_bus_active: swd_bus_active {
				phandle = <0x4c>;

				mux {
					pins = "gpio28", "gpio29";
					function = "gpio";
				};

				config {
					pins = "gpio28", "gpio29";
					output-low;
					bias-pull-down;
					drive-strength = <0x02>;
				};
			};

			swd_dap_active: swd_dap_active {
				phandle = <0x4d>;

				mux {
					pins = "gpio28", "gpio29";
					function = "gpio";
				};

				config {
					pins = "gpio28", "gpio29";
					output-high;
					bias-pull-up;
					drive-strength = <0x02>;
				};
			};
		};
	};

	fragment@17 {
		target = <&pm5100_qbg>;

		__overlay__ {
			qcom,vbat-cutoff-mv = <0xd3e>;
			qcom,vph-min-mv = <0xaf0>;
			qcom,iterm-ma = <0x23>;
			qcom,vbatt-empty-threshold-mv = <0xce4>;
		};
	};

	fragment@18 {
		target = <&pm5100_charger>;

		__overlay__ {
			qcom,auto-recharge-soc = <0x32>;
		};
	};

	fragment@19 {
		target = <&soc>;

		__overlay__ {

			i2c_mcu: i2c_mcu_gpio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "i2c-gpio";
				gpios = <&tlmm>, <0x1d 0x00>, <&tlmm>, <0x1c 0x00>;
				i2c-gpio,delay-us = <0x02>;
				status = "ok";
				phandle = <0x76>;
			};

			oplus,power-notify {
				compatible = "oplus,power-notify";
				status = "ok";
			};
		};
	};

	fragment@20 {
		target = <&soc>;

		__overlay__ {

			vld_pixart: gpio-regulator@63 {
				compatible = "regulator-fixed";
				regulator-name = "vld_pixart";
				gpio = <&tlmm>, <0x3f 0x00>;
				enable-active-high;
				phandle = <0x4e>;
			};
		};
	};

	fragment@21 {
		target = <&qupv3_se1_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0x61a80>;

			pat_crown: pixart_pat9125@75 {
				compatible = "pixart,pat9125";
				status = "disabled";
				reg = <0x75>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x38 0x00>;
				vld-supply = <&vld_pixart>;
				irq-gpio = <&tlmm>, <0x38 0x00>;
				oplus_crown,irq-gpio = <&tlmm>, <0x38 0x00>;
				pinctrl-names = "oplus_crown_pinctrl_active", "oplus_crown_pinctrl_suspend", "oplus_crown_pinctrl_release";
				pinctrl-0 = <&oplus_crown_int_active>;
				pinctrl-1 = <&oplus_crown_int_suspend>;
				pinctrl-2 = <&oplus_crown_int_release>;
				oplus_crown,notify_id = <0x00>;
				oplus_crown,force_init = <0x00>;
				oplus_crown,default_init = <0x00>;
				phandle = <0x77>;
			};

			mot_crown: mixosense,mot6010@74 {
				compatible = "mixosense,mot6010";
				status = "okay";
				reg = <0x74>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x38 0x00>;
				vld-supply = <&vld_pixart>;
				irq-gpio = <&tlmm>, <0x38 0x00>;
				oplus_crown,irq-gpio = <&tlmm>, <0x38 0x00>;
				pinctrl-names = "oplus_crown_pinctrl_active", "oplus_crown_pinctrl_suspend", "oplus_crown_pinctrl_release";
				pinctrl-0 = <&oplus_crown_int_active>;
				pinctrl-1 = <&oplus_crown_int_suspend>;
				pinctrl-2 = <&oplus_crown_int_release>;
				oplus_crown,notify_id = <0x01>;
				oplus_crown,force_init = <0x01>;
				oplus_crown,default_init = <0x01>;
				phandle = <0x78>;
			};
		};
	};

	fragment@22 {
		target = <&tlmm>;

		__overlay__ {

			oplus_crown_int_active: oplus_crown_int_active {
				phandle = <0x4f>;

				mux {
					pins = "gpio56";
					function = "gpio";
				};

				config {
					pins = "gpio56";
					input-enable;
					bias-pull-up;
					drive-strength = <0x02>;
				};
			};

			oplus_crown_int_suspend: oplus_crown_int_suspend {
				phandle = <0x50>;

				mux {
					pins = "gpio56";
					function = "gpio";
				};

				config {
					pins = "gpio56";
					input-enable;
					bias-pull-up;
					drive-strength = <0x02>;
				};
			};

			oplus_crown_int_release: oplus_crown_int_release {
				phandle = <0x51>;

				mux {
					pins = "gpio56";
					function = "gpio";
				};

				config {
					pins = "gpio56";
					input-enable;
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@23 {
		target = <&qupv3_se2_spi>;

		__overlay__ {
			status = "okay";
			qcom,rt;
			qcom,slv-ctrl;
			qcom,use-fixed-timeout;
			qcom,xfer-timeout-offset = <0x64>;
			oplus,auto-suspend-delay = <0xfa>;

			bes_wlan: slave@0 {
				compatible = "bes2610,master_spi";
				reg = <0x00>;
				spi-max-frequency = <0x2dc6c00>;
				spi_bits_per_word = <0x20>;
				label = "bes";
				WIFI,poweren_gpio = <&tlmm>, <0x1b 0x00>;
				slave-rx-ready-gpio = <&tlmm>, <0x4a 0x00>;
				slave-tx-ready-gpio = <&tlmm>, <0x4b 0x00>;
				master-tx-ind-gpio = <&tlmm>, <0x1a 0x00>;
				master-crc-ok-gpio = <&tlmm>, <0x06 0x00>;
				slave-crc-ok-gpio = <&tlmm>, <0x4e 0x00>;
				phandle = <0x79>;
			};
		};
	};

	fragment@24 {
		target = <&qupv3_se1_i2c>;

		__overlay__ {

			tsc@24 {
				compatible = "parade,pt_i2c_adapter";
				reg = <0x24>;
				status = "ok";
				interrupt-parent = <&tlmm>;
				interrupts = <0x50 0x2008>;
				parade,adapter_id = "pt_i2c_adapter";
				vcc_i2c-supply = <&tp_vdd_1v8>;
				vdd-supply = <&tp_vdd_3v0>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				pinctrl-0 = <&ts_int_active>, <&ts_reset_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				pinctrl-2 = <&ts_release>;

				parade,core {
					parade,name = "pt_core";
					parade,irq_gpio = <&tlmm>, <0x0d 0x2008>;
					parade,rst_gpio = <&tlmm>, <0x0c 0x00>;
					parade,hid_desc_register = <0x01>;
					parade,flags = <0x06>;
					parade,easy_wakeup_gesture = <0x01>;
					parade,config_dut_generation = <0x01>;

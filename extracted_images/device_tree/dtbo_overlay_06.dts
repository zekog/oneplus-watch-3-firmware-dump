/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Monaco Watch V5B01 overlay";
	qcom,board-id = <0x10022 0x01>;
	oplus,project-id = <0x6187>;
	oplus,hw-id = <0x04 0x02 0xffffffff>;

	fragment@0 {
		target = <&thermal_zones>;

		__overlay__ {

			pm5100-tz {

				cooling-maps {

					trip0_cpu0 {
						trip = <&pm5100_trip0>;
						cooling-device = <&CPU0>, <0x01 0x01>;
					};

					trip1_cpu2 {
						trip = <&pm5100_trip0>;
						cooling-device = <&cpu2_pause>, <0x01 0x01>;
					};

					trip1_cpu3 {
						trip = <&pm5100_trip0>;
						cooling-device = <&cpu3_pause>, <0x01 0x01>;
					};
				};
			};

			pm5100-bcl-lvl0 {

				cooling-maps {

					cpu0_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&CPU0>, <0x02 0x02>;
					};

					cpu2_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&cpu2_pause>, <0x01 0x01>;
					};

					cpu3_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&cpu3_pause>, <0x01 0x01>;
					};

					gpu_cdev {
						trip = <&bcl_lvl0>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};

			pm5100-bcl-lvl1 {

				cooling-maps {

					cpu0_cdev {
						trip = <&bcl_lvl1>;
						cooling-device = <&CPU0>, <0x02 0x02>;
					};

					cpu1_cdev {
						trip = <&bcl_lvl1>;
						cooling-device = <&cpu1_pause>, <0x01 0x01>;
					};

					gpu_cdev {
						trip = <&bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x04 0xffffffff>;
					};
				};
			};

			pm5100-bcl-lvl2 {

				cooling-maps {
				};
			};

			socd {

				cooling-maps {

					soc_cpu0 {
						trip = <&socd_trip>;
						cooling-device = <&CPU0>, <0x01 0x01>;
					};

					soc_cpu2 {
						trip = <&socd_trip>;
						cooling-device = <&cpu2_pause>, <0x01 0x01>;
					};

					soc_cpu3 {
						trip = <&socd_trip>;
						cooling-device = <&cpu3_pause>, <0x01 0x01>;
					};

					gpu_cdev {
						trip = <&socd_trip>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&pm5100_haptics>;

		__overlay__ {

			effect_6 {
				qcom,effect-id = <0x11>;
				qcom,wf-vmax-mv = <0x12c0>;
				qcom,wf-fifo-data = <0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff 0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff>;
				qcom,wf-fifo-period = <0x06>;
				qcom,wf-brake-disable;
				qcom,wf-auto-res-disable;
			};

			effect_7 {
				qcom,effect-id = <0x12>;
				qcom,wf-vmax-mv = <0x12c0>;
				qcom,wf-fifo-data = <0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff 0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff>;
				qcom,wf-fifo-period = <0x06>;
				qcom,wf-brake-disable;
				qcom,wf-auto-res-disable;
			};

			effect_8 {
				qcom,effect-id = <0x13>;
				qcom,wf-vmax-mv = <0x12c0>;
				qcom,wf-fifo-data = <0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff 0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff>;
				qcom,wf-fifo-period = <0x06>;
				qcom,wf-brake-disable;
				qcom,wf-auto-res-disable;
			};

			effect_9 {
				qcom,effect-id = <0x14>;
				qcom,wf-vmax-mv = <0x12c0>;
				qcom,wf-fifo-data = <0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff 0x00 0x00 0x01 0x1010101 0x1010101 0x2020202 0x2030303 0x4040405 0x5050606 0x7080809 0xa0b0c0c 0xd0e0f0f 0xf0f0f0f 0xe0e0d0c 0xb0a0908 0x6050301 0xfffdfa 0xf8f6f3f1 0xeeece9e6 0xe3e0dcd9 0xd5d1cdc8 0xc4bfbbb9 0xb7b6b7b8 0xbabdc1c5 0xcbd1d7de 0xe5edf5fd 0x40d151e 0x262e363d 0x444b5156 0x5b5f6264 0x65656463 0x5f5b5650 0x4a453f3a 0x342f2924 0x1f1a140f 0xa0500fc 0xf8f3efea 0xe6e2dfdc 0xd9d6d4d3 0xd2d1d1d1 0xd2d4d7da 0xdee2e8ee 0xf6fd0208 0xd12161a 0x1d202326 0x282a2b2d 0x2e2f3030 0x30313131 0x3130302f 0x2f2e2d2c 0x2c2b2a29 0x28262524 0x23222120 0x1e1d1c1b 0x1a191716 0x15141312 0x11100f0e 0xd0c0b0a 0xa090807 0x7060504 0x4030302 0x2010100 0x00 0xffffffff 0xfefefefe 0xfdfdfdfd 0xfdfdfdfd 0xfdfcfcfc 0xfcfcfcfc 0xfcfcfcfc 0xfcfdfdfd 0xfdfdfdfd 0xfdfdfdfd 0xfdfdfdfe 0xfefefefe 0xfefefefe 0xfefeffff 0xffffffff 0xffffffff 0xffffffff>;
				qcom,wf-fifo-period = <0x06>;
				qcom,wf-brake-disable;
				qcom,wf-auto-res-disable;
			};
		};
	};

	fragment@2 {
		target = <&sdhc_1>;

		__overlay__ {
			status = "ok";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&sdc1_on>;
			pinctrl-1 = <&sdc1_off>;
			vdd-supply = <&L25A>;
			qcom,vdd-voltage-level = <0x2eff40 0x2eff40>;
			qcom,vdd-current-level = <0x00 0x3d090>;
			vdd-io-supply = <&L15A>;
			qcom,vdd-io-always-on;
			qcom,vdd-io-lpm-sup;
			qcom,vdd-io-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-io-current-level = <0x00 0x3d090>;
		};
	};

	fragment@3 {
		target = <&pm5100_sdam_2>;

		__overlay__ {

			hap_cl_brake: cl_brake@7c {
				reg = <0x7c 0x01>;
				bits = <0x00 0x08>;
				phandle = <0x01>;
			};
		};
	};

	fragment@4 {
		target = <&pm5100_haptics>;

		__overlay__ {
			nvmem-cell-names = "hap_cl_brake";
			nvmem-cells = <&hap_cl_brake>;
			nvmem-names = "hap_cfg_sdam";
			nvmem = <&pm5100_sdam_23>;
			status = "okay";
		};
	};

	fragment@5 {
		target = <&pm5100_qbg>;

		__overlay__ {
			status = "ok";
			qcom,battery-data = <&monaco_batterydata>;
			nvmem-cell-names = "qbg_debug_mask_low", "qbg_debug_mask_high", "skip_esr_state";
			nvmem-cells = <&qbg_debug_mask_low>, <&qbg_debug_mask_high>, <&skip_esr_state>;
			#io-channel-cells = <0x01>;
			io-channels = <&pm5100_adc>, <0x26>, <&pm5100_adc>, <0x45>, <&pm5100_charger>, <0x39>, <&pm5100_charger>, <0x3f>, <&pm5100_charger>, <0x40>, <&pm5100_charger>, <0x7d>;
			io-channel-names = "batt-temp", "batt-id", "charge_done", "recharge_soc", "force_recharge", "sys_soc";
			qcom,vbat-cutoff-mv = <0xce4>;
			qcom,ibat-cutoff-ma = <0x0a>;
			qcom,vph-min-mv = <0x9c4>;
			qcom,iterm-ma = <0x14>;
			qcom,vbatt-empty-threshold-mv = <0xbb8>;
		};
	};

	fragment@6 {
		target = <&pm5100_charger>;

		__overlay__ {
			#io-channel-cells = <0x01>;
			io-channels = <&pm5100_adc>, <0x11>, <&pm5100_adc>, <0x17>, <&pm5100_adc>, <0x10>, <&pm5100_adc>, <0x03>, <&pm5100_adc>, <0x8e>, <&pm5100_qbg>, <0x4b>, <&pm5100_qbg>, <0x46>, <&pm5100_qbg>, <0x45>, <&pm5100_qbg>, <0x42>, <&pm5100_qbg>, <0x47>, <&pm5100_qbg>, <0x5d>, <&pm5100_qbg>, <0x4e>, <&pm5100_qbg>, <0x48>, <&pm5100_qbg>, <0x2d>, <&pm5100_qbg>, <0x53>, <&pm5100_qbg>, <0x49>, <&pm5100_qbg>, <0x52>, <&pm5100_qbg>, <0x54>, <&pm5100_qbg>, <0x56>;
			io-channel-names = "usb_in_voltage", "usb_in_current", "chg_temp", "die_temp", "vph_voltage", "resistance_id", "voltage_now", "temp", "capacity", "voltage_ocv", "voltage_avg", "debug_battery", "current_now", "voltage_max", "charge_full", "charge_counter", "cycle_count", "charge_full_design", "time_to_full_now";
		};
	};

	fragment@7 {
		target = <&soc>;

		__overlay__ {

			smmu_sde_unsec: qcom,smmu_sde_unsec_cb {
				compatible = "qcom,smmu_sde_unsec";
				iommus = <&apps_smmu>, <0x420 0x02>;
				qcom,iommu-dma-addr-pool = <0x20000 0xfffe0000>;
				qcom,iommu-faults = "non-fatal";
				qcom,iommu-earlymap;
				phandle = <0x04>;
			};

			smmu_sde_sec: qcom,smmu_sde_sec_cb {
				compatible = "qcom,smmu_sde_sec";
				iommus = <&apps_smmu>, <0x421 0x00>;
				qcom,iommu-dma-addr-pool = <0x20000 0xfffe0000>;
				qcom,iommu-faults = "non-fatal";
				qcom,iommu-vmid = <0x0a>;
				phandle = <0x56>;
			};

			mdss_mdp: qcom,mdss_mdp@5e00000 {
				compatible = "qcom,sde-kms";
				reg = <0x5e00000 0x8f030 0x5eb0000 0x2008 0x5e8f000 0x2c 0xc125ba4 0x20>;
				reg-names = "mdp_phys", "vbif_phys", "sid_phys", "sde_imem_phys";
				clocks = <&gcc>, <0x43>, <&gcc>, <0x44>, <&dispcc>, <0x00>, <&dispcc>, <0x08>, <&dispcc>, <0x0e>, <&dispcc>, <0x0a>;
				clock-names = "gcc_bus", "throttle_clk", "iface_clk", "core_clk", "vsync_clk", "lut_clk";
				clock-rate = <0x00 0x00 0x00 0x11e1a300 0x124f800 0xb71b000>;
				clock-max-rate = <0x00 0x00 0x00 0x17d78400 0x124f800 0x17d78400>;
				sde-vdd-supply = <&mdss_core_gdsc>;
				#cooling-cells = <0x02>;
				interconnects = <&mmrt_virt>, <0x0e>, <&bimc>, <0x200>, <&bimc>, <0x00>, <&config_noc>, <0x212>;
				interconnect-names = "qcom,sde-data-bus0", "qcom,sde-reg-bus";
				interrupts = <0x00 0xba 0x04>;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				#power-domain-cells = <0x00>;
				qcom,sde-ib-bw-vote = <0x2625a0 0x00 0x2625a0>;
				qcom,sde-off = <0x1000>;
				qcom,sde-len = <0x494>;
				qcom,sde-ctl-off = <0x2000>;
				qcom,sde-ctl-size = <0x1dc>;
				qcom,sde-ctl-display-pref = "primary";
				qcom,sde-mixer-off = <0x45000>;
				qcom,sde-mixer-size = <0x320>;
				qcom,sde-mixer-display-pref = "primary";
				qcom,sde-dspp-top-off = <0x1300>;
				qcom,sde-dspp-top-size = <0x80>;
				qcom,sde-dspp-off = <0x55000>;
				qcom,sde-dspp-size = <0xfe4>;
				qcom,sde-dspp-rc-version = <0x10000>;
				qcom,sde-dspp-rc-off = <0x15800>;
				qcom,sde-dspp-rc-size = <0x100>;
				qcom,sde-dspp-rc-mem-size = <0xaa0>;
				qcom,sde-intf-off = <0x00 0x6b800>;
				qcom,sde-intf-size = <0x2b8>;
				qcom,sde-intf-type = "none", "dsi";
				qcom,sde-intf-tear-irq-off = <0x00 0x6e800>;
				qcom,sde-pp-off = <0x71000>;
				qcom,sde-pp-size = <0xd4>;
				qcom,sde-dither-off = <0x30e0>;
				qcom,sde-dither-version = <0x10000>;
				qcom,sde-dither-size = <0x20>;
				qcom,sde-sspp-type = "vig", "dma";
